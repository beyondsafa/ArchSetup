{
    "additional-packages": [
        "micro", "git", "rustup", "base-devel", "curl", "wget", "sudo", "fish",
        "ttf-freebanglafont", "ttf-jetbrains-mono-nerd",
        "eza", "bat", "ripgrep", "fd", "zoxide", "dust",
        "qbittorrent", "aria2", "android-tools", "rclone",
        "kdeconnect", "fastfetch", "haruna", "mpv", "vlc", "spotify-launcher",
        "profile-sync-daemon"
    ],
    "desktop-environment": "kde",
    "hostname": "archrocket",
    "kernels": [
        "linux-zen"
    ],
    "profile": "Desktop",
    "services": [
        "systemd-oomd",
        "psd",
        "bluetooth",
        "cups"
    ],
    "timezone": "Asia/Dhaka",
    "locale_config": {
        "kb_layout": "us",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US.UTF-8"
    },
    "audio_config": {
        "audio": "pipewire"
    },
    "bootloader": "systemd-boot",
    "swap": true,
    "zram": true,
    "disk_config": {
        "filesystem": "ext4"
    },
    "network_config": {
        "type": "nm_iwd"
    },
    "pacman_config": {
        "color": true,
        "parallel_downloads": 5
    },
    "profile_config": {
        "gfx_driver": "All open-source",
        "greeter": "plasma-login-manager"
    }
}
